# Placeholder file — Node local mặc định không cần đặt biến nào.
# Giải thích đầy đủ tại docs/ENV.md. Không bao giờ đặt giá trị secret thật vào file này.

# Cổng server API độc lập (npm run api). Mặc định: 3001
API_PORT=3001
# Địa chỉ bind server API. Mặc định: 127.0.0.1
API_HOST=127.0.0.1

# Chỉ bật sau proxy kiểm soát được, ghi đè X-Forwarded-For; xem docs/ENV.md.
TRUST_PROXY=0

# Django: debug mặc định tắt. Production phải cung cấp secret riêng qua môi trường.
# DJANGO_SECRET_KEY=<set-through-deployment-secret-store>
# Chỉ dùng local nếu muốn cho phép khóa phát triển:
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Bật công cụ sự kiện trình diễn (operator). Chỉ đặt 1 khi cần demo có kiểm soát.
# DANA_PRESENTATION_EVENTS=1

# Dịch vụ tính tuyến đi bộ. Mặc định đã hợp lệ cho local.
# VALHALLA_URL=https://valhalla1.openstreetmap.de/

# Tùy chọn, chỉ chạy phía server nếu sau này cần. Không đặt vào biến VITE_*.
# GOOGLE_MAPS_API_KEY=<your-key-if-ever-needed>
